; boot.tscn — SIOS boot screen
; Shows the SIOS brand, then transitions to the main desktop.
[gd_scene load_steps=3 format=3]

[ext_resource path="res://scripts/SIOSBoot.gd" type="Script" id="1"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_bg"]
bg_color = Color(0.031, 0.027, 0.02, 1)

[node name="SIOSBoot" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_bg")
script = ExtResource("1")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 24

[node name="Title" type="Label" parent="VBox"]
layout_mode = 2
text = "SIOS"
horizontal_alignment = 1
theme_override_colors/font_color = Color(0.886, 0.78, 0.494, 1)
theme_override_font_sizes/font_size = 72

[node name="Subtitle" type="Label" parent="VBox"]
layout_mode = 2
text = "Sovereign Interactive Operating System"
horizontal_alignment = 1
theme_override_colors/font_color = Color(0.471, 0.505, 0.541, 1)
theme_override_font_sizes/font_size = 16

[node name="Status" type="Label" parent="VBox"]
layout_mode = 2
text = "Initializing..."
horizontal_alignment = 1
theme_override_colors/font_color = Color(0.764, 0.639, 0.353, 1)
theme_override_font_sizes/font_size = 12
