[Unit]
Description=ANUBIS Intelligence Daemon
Documentation=file:///opt/sios-live/tools/anubis_daemon.py
After=ollama.service sios-first-boot.service
Requires=ollama.service

[Service]
Type=simple
ExecStartPre=/bin/sleep 5
ExecStartPre=/usr/bin/python3 -m anubis.boot_check
ExecStart=/usr/bin/python3 /opt/sios-live/tools/anubis_daemon.py
Restart=on-failure
RestartSec=5
User=root
Environment=ANUBIS_MODEL=qwen2.5-coder:7b
Environment=ANUBIS_OLLAMA=http://127.0.0.1:11434
Environment=ANUBIS_SOCKET=/tmp/anubis.sock
Environment=ANUBIS_ROOT=/opt/sios-live
Environment=PYTHONPATH=/opt/sios-live
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
