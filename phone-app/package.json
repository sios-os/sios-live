{
  "name": "anubis-companion",
  "version": "1.0.0",
  "private": true,
  "description": "ANUBIS phone companion app — telemetry, chat, alerts, and remote control",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "build:android": "cd android && ./gradlew assembleRelease",
    "clean": "cd android && ./gradlew clean && cd .. && rm -rf node_modules && npm install",
    "test": "jest",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-native": "0.74.0",
    "@react-native-async-storage/async-storage": "^1.23.0",
    "@react-native-community/geolocation": "^2.1.0",
    "@react-navigation/native": "^6.1.0",
    "@react-navigation/bottom-tabs": "^6.5.0",
    "@react-navigation/native-stack": "^6.9.0",
    "react-native-background-actions": "^3.0.0",
    "react-native-device-info": "^10.13.0",
    "react-native-sensors": "^7.3.0",
    "react-native-vector-icons": "^10.0.0",
    "react-native-safe-area-context": "^4.10.0",
    "react-native-screens": "^3.31.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native/babel-preset": "0.74.0",
    "@react-native/eslint-config": "0.74.0",
    "@react-native/metro-config": "0.74.0",
    "@react-native/typescript-config": "0.74.0",
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.73.0",
    "typescript": "^5.0.0"
  },
  "jest": {
    "preset": "react-native"
  }
}
